# Environment
ENVIRONMENT=development

# Database (Supabase PostgreSQL / local PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mock_interview

# Supabase Auth & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Providers
TEXT_AI_PROVIDER=gemini
LIVE_AI_PROVIDER=gemini_live
EVALUATION_AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Groq API (Optional Fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Storage
RECORDING_BUCKET_NAME=interview-recordings
MAX_RECORDING_SIZE_MB=50
MAX_RESUME_SIZE_MB=10

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
